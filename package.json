{
  "name": "cadence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "corepack pnpm --filter @cadence/web dev",
    "build": "corepack pnpm --filter @cadence/core --filter @cadence/web typecheck && corepack pnpm --filter @cadence/web build",
    "typecheck": "corepack pnpm --filter @cadence/core --filter @cadence/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "corepack pnpm --filter @cadence/core --filter @cadence/web test",
    "test:e2e": "corepack pnpm --filter @cadence/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
